# Base de datos
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# JWT
JWT_SECRET=

# Cloudinary (almacenamiento permanente de las imágenes generadas por IA)
# Podés usar la variable combinada CLOUDINARY_URL (la que te muestra el dashboard de Cloudinary)...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...o las 3 variables sueltas en vez de CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
