# Base de datos (PostgreSQL en Aiven)
# Opción 1 (recomendada): la "Service URI" completa que muestra Aiven
DATABASE_URL=postgres://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
# Opción 2: variables sueltas (se usan solo si DATABASE_URL está vacía)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=defaultdb
# DB_PORT=
# Zona horaria de la sesión (opcional, por defecto America/Argentina/Buenos_Aires)
# DB_TIMEZONE=America/Argentina/Buenos_Aires

# Keep-alive (opcional): si se define, /api/keepalive exige "Authorization: Bearer <CRON_SECRET>".
# Vercel lo manda solo en sus cron jobs.
# CRON_SECRET=

# JWT
JWT_SECRET=

# Cloudinary (almacenamiento permanente de las imágenes generadas por IA)
# Podés usar la variable combinada CLOUDINARY_URL (la que te muestra el dashboard de Cloudinary)...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...o las 3 variables sueltas en vez de CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Hugging Face (generación de imágenes con IA, modelo stable-diffusion-3-medium)
# Token "Read" gratuito: https://huggingface.co/settings/tokens
HF_TOKEN=
