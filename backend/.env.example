# Base de datos
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
# Recomendado: contenido PEM del "CA certificate" de Aiven (Overview → Connection information).
# Con esta variable se valida el certificado del servidor (evita man-in-the-middle).
# Se puede pegar en una sola línea reemplazando los saltos de línea por \n.
DB_CA_CERT=
# Solo para una base local sin SSL (desarrollo/test). En producción no definirla.
# DB_SSL=false

# JWT
# Cadena larga y aleatoria, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (almacenamiento permanente de las imágenes generadas por IA)
# Podés usar la variable combinada CLOUDINARY_URL (la que te muestra el dashboard de Cloudinary)...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...o las 3 variables sueltas en vez de CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Hugging Face (generación de imágenes con IA, modelo stable-diffusion-3-medium)
# Token "Read" gratuito: https://huggingface.co/settings/tokens
HF_TOKEN=
